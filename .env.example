# Optional local overrides for a cloned brain_code workspace.
#
# Copy to .env only if your local tooling reads .env files. The Python scripts
# do not require this file by default.

# Absolute path to the Python interpreter you want scripts to use.
# BRAIN_PYTHON_EXE=%USERPROFILE%\miniconda3\envs\brain-vision\python.exe

# Repository root. Defaults are normally inferred from the file location.
# BRAIN_CODE_ROOT=<repo>

# Optional YOLO weights override for historical vision scripts.
# BRAIN_VISION_WEIGHTS=<repo>\hybrid_controller\models\vision\best.pt

# Optional remote training defaults used by SSVEP server tools.
# BRAIN_REMOTE_ROOT=/data1/zkx/brain
# BRAIN_REMOTE_PYTHON=/data1/zkx/miniconda3/envs/brain-ssvep/bin/python

# Optional JetMax deployment defaults.
# JETMAX_HOST=192.168.149.1
# JETMAX_REMOTE_ROOT=/home/hiwonder/brain_code

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pzy66.local/brain-code/mi-profile.schema.json",
  "title": "MI classifier profile",
  "type": "object",
  "required": [
    "profile_id",
    "schema_version",
    "created_at",
    "model",
    "classes",
    "runtime"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Stable identifier for the published MI profile."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 timestamp generated by the MI training pipeline."
    },
    "model": {
      "type": "object",
      "required": ["family", "artifact_path"],
      "properties": {
        "family": {
          "type": "string",
          "description": "Examples: csp-lda, fbcsp-svm, eegnet, atcnet."
        },
        "artifact_path": {
          "type": "string",
          "description": "Path to a local model artifact. Real weights are not required to be tracked by Git."
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean", "null"]
          }
        }
      },
      "additionalProperties": true
    },
    "classes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "required": ["sample_rate_hz", "window_s", "step_s"],
      "properties": {
        "sample_rate_hz": {"type": "number"},
        "window_s": {"type": "number"},
        "step_s": {"type": "number"},
        "confidence_threshold": {"type": "number"},
        "idle_policy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "training_entry": {
      "type": "string"
    },
    "realtime_entry": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

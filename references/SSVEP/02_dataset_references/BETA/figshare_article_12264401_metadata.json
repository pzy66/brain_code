wnload_url": "https://ndownloader.figshare.com/files/22618391", "supplied_md5": "f6ab1d6719c0eafa12bd5bd7940d10b2", "computed_md5": "f6ab1d6719c0eafa12bd5bd7940d10b2", "mimetype": "application/octet-stream"}, {"id": 22618394, "name": "S69.mat", "size": 79582031, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/22618394", "supplied_md5": "05eafc3ac4c475f554fab0d47df77759", "computed_md5": "05eafc3ac4c475f554fab0d47df77759", "mimetype": "application/octet-stream"}, {"id": 22618397, "name": "S70.mat", "size": 79634812, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/22618397", "supplied_md5": "6e0b15e456e1413caf3eb013a07b6481", "computed_md5": "6e0b15e456e1413caf3eb013a07b6481", "mimetype": "application/octet-stream"}], "folder_structure": {}, "authors": [{"id": 4806741, "full_name": "Bingchuan Liu", "first_name": "Bingchuan", "last_name": "Liu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8810274, "full_name": "Xiaoshan Huang", "first_name": "Xiaoshan", "last_name": "Huang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8812567, "full_name": "Yijun Wang", "first_name": "Yijun", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8812568, "full_name": "Xiaogang Chen", "first_name": "Xiaogang", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8812570, "full_name": "Xiaorong Gao", "first_name": "Xiaorong", "last_name": "Gao", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/The_BETA_database/12264401", "download_disabled": false, "description": "The brain-computer interface (BCI) provides an alternative means to communicate and it has sparked growing interest in the past two decades. Specifically, for Steady-State Visual Evoked Potential (SSVEP) based BCI, marked improvement has been made in the frequency recognition method and data sharing. However, the number of pubic databases is still limited in this field. Therefore, we present a \\textbf{BE}nchmark database \\textbf{T}owards BCI \\textbf{A}pplication (BETA) in the study. The BETA database is composed of 64-channel Electroencephalogram (EEG) data of 70 subjects performing a 40-target cued-spelling task. The design and the acquisition of the BETA is in pursuit of meeting the demand from real-world applications and it can be used as a test-bed for these scenarios. We validate the database by a series of analyses and conduct the classification analysis of eleven frequency recognition methods on BETA. We recommend to use the metric of wide-band signal-to-noise ratio (SNR) and BCI quotient to characterize the SSVEP at the single-trial and population levels, respectively. The BETA database has an alternative download website link of http://bci.med.tsinghua.edu.cn/download.html.", "funding": "Doctoral Brain +  X Seed Grant Program of Tsinghua University", "funding_list": [{"id": 17144477, "title": "Doctoral Brain +  X Seed Grant Program of Tsinghua University", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 17144480, "title": "Strategic Priority Research Program of Chinese Academy of Science (No. XDB32040200)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 17144483, "title": "National Key Research and Development Program of China (No. 2017YFB1002505)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 17144486, "title": "Key Research and Development Program of Guangdong Province (No. 2018B030339001)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 17144492, "title": "National Natural Science Foundation of China under Grant 61431007", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 3, "status": "public", "size": 5276556984, "created_date": "2022-06-15T04:34:48Z", "modified_date": "2023-06-02T06:03:48Z", "is_public": true, "is_confidential": 